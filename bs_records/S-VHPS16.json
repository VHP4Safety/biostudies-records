    "attributes" : [
      {
        "name" : "Title",
        "value" : "Exposure matters: the impact of in vitro exposure scenarios"
      },
      {
        "name" : "ReleaseDate",
        "value" : "2026-05-25"
      },
      {
        "name" : "Description",
        "value" : "This study examines how different in vitro exposure scenarios influence the toxicity of pesticides in differentiated SH-SY5Y dopaminergic-like cells. Cells were exposed under varying scenarios — single 24 h exposures with different delays before measurement (0, 18, 72 h), a repeated exposure (4 × 6 h) and a prolonged 96 h exposure — and two endpoints were measured in parallel: mitochondrial metabolic activity (alamarBlue) and cytotoxicity (lactate dehydrogenase release)."
      },
      {
        "name" : "Organism",
        "value" : "Homo sapiens",
        "valqual" : [
